# =================== INSTANT MEDIA RELEASE ===================
# Production Environment Configuration
# Copy this file to .env and fill in your values

# =================== REQUIRED: AI MODEL ===================
# OpenAI API Configuration (REQUIRED)
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o  # or gpt-4o for higher quality
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4000

# =================== DATABASE CONFIGURATION ===================
# SQLite Database (Default - Production Ready)
DATABASE_URL=sqlite:///./media_release.db

# PostgreSQL (Recommended for Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/media_release

# =================== SERVER CONFIGURATION ===================
# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
CORS_ORIGINS=["http://localhost:3000", "https://yourdomain.com"]

# =================== VECTOR DATABASE ===================
# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=media_outlets

# =================== AGENT CONFIGURATION ===================
# Agent Performance Settings
AGENT_MEMORY_ENABLED=true
AGENT_REASONING_ENABLED=true
AGENT_PARALLEL_PROCESSING=true
MAX_AGENT_RETRIES=3
AGENT_TIMEOUT_SECONDS=120

# =================== BUSINESS LOGIC ===================
# Package Pricing (VND)
STARTER_PACKAGE_PRICE=12000000
STANDARD_PACKAGE_PRICE=30000000  
PREMIUM_PACKAGE_PRICE=50000000

# Media Outlet Limits
STARTER_MEDIA_COUNT=3
STANDARD_MEDIA_COUNT=15
PREMIUM_MEDIA_COUNT=18

# =================== MONITORING & ANALYTICS ===================
# Optional: Agno.com Monitoring
# AGNO_API_KEY=your-agno-monitoring-key
# AGNO_PROJECT_ID=your-project-id

# Optional: LangTrace Monitoring
# LANGTRACE_API_KEY=your-langtrace-key

# Disable Telemetry (Optional)
# AGNO_TELEMETRY=false

# =================== PRODUCTION OPTIMIZATIONS ===================
# Memory Management
PYTHON_MALLOC_STATS=1
MALLOC_ARENA_MAX=4

# Performance
UVICORN_WORKERS=1
UVICORN_BACKLOG=2048

# =================== DEVELOPMENT ONLY ===================
# Development Settings (Don't use in production)
# DEBUG=True
# LOG_LEVEL=DEBUG
# CORS_ORIGINS=["*"]